{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5009"
      }
    }
  },
  "Kafka": {
    "BootstrapServers": "kafka:29092",
    "ClientId": "projection-service",
    "GroupId": "projection-service",
    "SecurityProtocol": "Plaintext",
    "EnableIdempotence": true,
    "PrintStationId": "PRINT-STATION-01",
    "PrinterAdapterId": "PRINT-ADAPTER-01"
  },
  "SQLITE_PROJECTION_PATH": "data/projection.db",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
