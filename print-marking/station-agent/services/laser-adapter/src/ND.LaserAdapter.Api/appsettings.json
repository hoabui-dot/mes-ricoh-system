{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5004"
      }
    }
  },
  "Kafka": {
    "BootstrapServers": "kafka:29092",
    "ClientId": "laser-adapter",
    "GroupId": "laser-adapter",
    "SecurityProtocol": "Plaintext",
    "EnableIdempotence": true,
    "PrintStationId": "PRINT-STATION-01",
    "PrinterAdapterId": "PRINT-ADAPTER-01"
  },
  "Laser": {
    "Host": "localhost",
    "Port": "8901"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
