{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5002"
      }
    }
  },
  "Kafka": {
    "BootstrapServers": "kafka:29092",
    "ClientId": "job-engine",
    "GroupId": "job-engine",
    "SecurityProtocol": "Plaintext",
    "EnableIdempotence": true,
    "PrintStationId": "PRINT-STATION-01",
    "PrinterAdapterId": "PRINT-ADAPTER-01"
  },
  "JobEngine": {
    "OutboxBatchSize": 10,
    "OutboxIntervalSeconds": 3
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
