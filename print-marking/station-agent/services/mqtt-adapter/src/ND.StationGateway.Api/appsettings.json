{
  "Mqtt": {
    "StationId": "edge-ipc-l3-marking",
    "BrokerHost": "localhost",
    "BrokerPort": 1883,
    "UseTls": false,
    "Username": "",
    "Password": "",
    "SubscribeTopics": [
      "nd/+/+/command"
    ],
    "OutboxBatchSize": 10,
    "OutboxIntervalSeconds": 5
  },
  "Kafka": {
    "BootstrapServers": "kafka:29092",
    "ClientId": "station-gateway",
    "GroupId": "station-gateway",
    "SecurityProtocol": "Plaintext",
    "EnableIdempotence": true,
    "PrintStationId": "PRINT-STATION-01",
    "PrinterAdapterId": "PRINT-ADAPTER-01"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
