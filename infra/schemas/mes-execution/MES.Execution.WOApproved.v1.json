{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MES.Execution.WOApproved.v1",
  "type": "object",
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "type": "string", "enum": ["MES.Execution.WOApproved.v1"] },
    "occurred_at": { "type": "string", "format": "date-time" },
    "source_service": { "type": "string" },
    "trace_id": { "type": "string" },
    "payload": {
      "type": "object",
      "properties": {
        "wo_id": { "type": "string", "format": "uuid" },
        "wo_code": { "type": "string" },
        "item_revision_id": { "type": "string", "format": "uuid" },
        "quantity": { "type": ["number", "string"] },
        "planned_start_at": { "type": "string", "format": "date-time" },
        "planned_end_at": { "type": "string", "format": "date-time" },
        "material_requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "component_item_revision_id": { "type": "string", "format": "uuid" },
              "required_qty": { "type": ["number", "string"] },
              "uom_id": { "type": "string", "format": "uuid" }
            },
            "required": ["component_item_revision_id", "required_qty"]
          }
        }
      },
      "required": ["wo_id", "wo_code", "item_revision_id", "quantity", "planned_start_at", "planned_end_at"]
    }
  },
  "required": ["event_id", "event_type", "occurred_at", "source_service", "trace_id", "payload"]
}
