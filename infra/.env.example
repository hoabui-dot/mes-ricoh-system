VITE_API_BASE_URL=https://telephony-felt-nodes-latitude.trycloudflare.com
VITE_MES_URL=https://trainers-blank-mate-fails.trycloudflare.com
VITE_WMS_URL=https://assumptions-just-third-rotation.trycloudflare.com
