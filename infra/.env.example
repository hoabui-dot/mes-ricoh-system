# Copy to infra/.env before running Compose, or pass it explicitly with
# `docker compose --env-file infra/.env ...`.
# Do not commit infra/.env. It contains deployment-specific values.

VITE_KEYCLOAK_URL=http://${PUBLIC_HOST}:18080
VITE_API_BASE_URL=http://${PUBLIC_HOST}:18000
VITE_MES_URL=http://${PUBLIC_HOST}:13052
VITE_WMS_URL=http://${PUBLIC_HOST}:13091
VITE_QMS_URL=http://${PUBLIC_HOST}:13130

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# External Kafka address advertised to the remote print station.
KAFKA_EXTERNAL_HOST=100.68.50.41
KAFKA_EXTERNAL_PORT=19092
VITE_STATION_ID=PRINT-STATION-01
KIOSK_CORS_ORIGINS=http://localhost:5007,http://100.68.50.41:5007
