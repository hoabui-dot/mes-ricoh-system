# MES demo/runtime policy. Service-specific ports and database URLs stay in
# docker-compose.mes.yml because each service owns a different value.
NODE_ENV=development
DEMO_KIOSK_TERMINAL_CODE=KIOSK-DEMO-01
SEED_ON_STARTUP=true
MES_RESOURCE_ALLOCATION_APPROVAL_REQUIRED=true
MES_DEMO_PRINT_ON_APPROVAL=true
DEMO_KIOSK_RECEIVE_ALL_WORKSTATIONS=true
MES_DEMO_PRINT_STATION_CODE=PRINT-STATION-01
MES_DEMO_PRINT_STATION_ID=6f56f652-bc6a-456e-a6b3-6284ab023f2d
MES_DEMO_PRINT_ADAPTER_ID=PRINT-ADAPTER-01
