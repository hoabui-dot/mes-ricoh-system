{
  "name": "mom-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "libs/*",
    "services/*",
    "portal"
  ],
  "scripts": {
    "dev:portal": "npm run dev --workspace=mom-unified-portal",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "i18n:audit:mes": "tsx scripts/i18n-audit/detect-mislabeled-vi.ts",
    "i18n:seed:enrich:mes": "tsx scripts/i18n-audit/enrich-known-seed-localized-text.ts",
    "i18n:register:qms-console": "tsx scripts/i18n-audit/register-qms-console-fallback-flags.ts",
    "seed:wms:demo": "tsx scripts/seed-wms-demo.ts",
    "seed:qms:demo": "tsx scripts/seed-qms-demo.ts",
    "seed:mes:labor:demo": "bash scripts/seed-mes-labor-demo.sh",
    "migrate:mes:legacy-fields": "tsx scripts/migrate-mes-legacy-fields.ts",
    "migrate:mes:legacy-skills": "tsx scripts/migrate-legacy-skills-to-central-skill-management.ts",
    "test:mes:operation-flow": "node scripts/test-mes-operation-workstation-workcenter-flow.mjs",
    "verify:mes:workstation-hydration": "node scripts/verify-workstation-form-hydration.mjs",
    "verify:mes:workstation-replacements": "node scripts/verify-workstation-replacement-semantics.mjs",
    "verify:mes:ebom": "node scripts/verify-ebom-crud-flow.mjs",
    "seed:mes:print-workstation": "node scripts/seed-print-workstation-flow.mjs",
    "verify:mes:print-workstation": "node scripts/verify-print-workstation-integration.mjs",
    "build:printer-adapter:images": "PRINTER_ADAPTER_PUSH=false bash scripts/build-printer-adapter-images.sh",
    "build:printer-adapter:both": "PRINTER_ADAPTER_PUSH=true bash scripts/build-printer-adapter-images.sh",
    "i18n:scan": "tsx scripts/i18n-scan/check-hardcoded-ui-strings.ts",
    "i18n:scan:wms-console": "tsx scripts/i18n-scan/check-hardcoded-ui-strings.ts services/wms-console/src",
    "test": "npm run test --workspaces --if-present",
    "infra:up": "docker compose -f infra/docker-compose.platform.yml -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.platform.yml -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.platform.yml -f infra/docker-compose.yml logs -f",
    "infra:ps": "docker compose -f infra/docker-compose.platform.yml -f infra/docker-compose.yml ps",
    "rebuild:mes": "bash scripts/rebuild-mes.sh",
    "up:print-station": "bash scripts/restart-print-station.sh",
    "down:print-station": "docker compose -f infra/docker-compose.platform.yml -f infra/docker-compose.print-station.yml down",
    "ps:print-station": "docker compose -f infra/docker-compose.platform.yml -f infra/docker-compose.print-station.yml ps",
    "rebuild:print-station": "bash scripts/rebuild-print-station.sh",
    "restart:print-station": "bash scripts/restart-print-station.sh",
    "verify:print-station": "node scripts/verify-print-station-realtime-flow.mjs",
    "logs:print-station": "bash scripts/logs-print-station.sh",
    "cloudflare:urls": "bash scripts/show-cloudflare-urls.sh",
    "verify:mes:wo-physical-print": "node scripts/verify-mes-wo-to-physical-print-flow.mjs",
    "cleanup:mes:work-orders": "node scripts/cleanup-mes-work-order-test-data.mjs",
    "reset:mes:wo:dry-run": "MES_ENV=development node scripts/reset-mes-wo-test-data.mjs --dry-run",
    "reset:mes:wo": "node scripts/reset-mes-wo-test-data.mjs --reset",
    "seed:mes:wo:dry-run": "MES_ENV=development node scripts/seed-mes-wo-complete-dataset.mjs --dry-run",
    "seed:mes:wo": "node scripts/seed-mes-wo-complete-dataset.mjs --seed",
    "reset:seed:mes:wo": "MES_ENV=development CONFIRM_MASTER_DATA_RESET=YES_RESET_E2E_MASTER_DATA node scripts/seed-mes-wo-complete-dataset.mjs --seed",
    "seed:mes:physical-printer-pv": "node scripts/seed-mes-physical-printer-pv.mjs",
    "ensure:mes:print-kafka-topics": "bash scripts/ensure-mes-print-kafka-topics.sh",
    "e2e:mes:physical-print": "npm run ensure:mes:print-kafka-topics && node scripts/run-mes-physical-print-e2e.mjs",
    "test:mes:wo:batch-print": "node scripts/test-mes-wo-batch-print.mjs",
    "test:kiosk:printer-template": "node scripts/test-kiosk-printer-template-activation.mjs"
  },
  "devDependencies": {
    "typescript-eslint": "^8.0.0",
    "eslint": "^9.5.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
