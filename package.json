{
  "name": "mom-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "libs/*",
    "services/*",
    "portal"
  ],
  "scripts": {
    "build:printer-adapter:images": "PRINTER_ADAPTER_PUSH=false bash scripts/build-printer-adapter-images.sh",
    "build:printer-adapter:both": "PRINTER_ADAPTER_PUSH=true bash scripts/build-printer-adapter-images.sh",
    "rebuild:mes": "bash scripts/rebuild-mes.sh",
    "rebuild:print-station": "bash scripts/rebuild-print-station.sh",
    "test:mes:machine-flow": "node scripts/test-mes-machine-flow.mjs",
    "test:mes:resource-planning-flow": "MES_ENV=development ALLOW_RESOURCE_PLANNING_MUTATION=true node scripts/test-mes-resource-planning-flow.mjs",
    "test:e2e:machine": "playwright test e2e/machine --project=chromium",
    "test:e2e:machine:smoke": "playwright test e2e/machine --grep @smoke --project=chromium",
    "test:e2e:machine:all": "playwright test e2e/machine --project=chromium",
    "test:e2e:machine:headed": "playwright test e2e/machine --project=chromium --headed",
    "test:e2e:machine:debug": "playwright test e2e/machine --project=chromium --debug",
    "test:e2e:resource-planning": "playwright test e2e/resource-planning --project=chromium",
    "test:e2e:resource-planning:smoke": "playwright test e2e/resource-planning --grep @smoke --project=chromium",
    "test:e2e:resource-planning:full": "playwright test e2e/resource-planning --project=chromium",
    "test:e2e:resource-planning:validation": "playwright test e2e/resource-planning --grep @validation --project=chromium",
    "test:e2e:resource-planning:concurrency": "playwright test e2e/resource-planning --grep @concurrency --project=chromium",
    "test:e2e:resource-planning:authorization": "playwright test e2e/resource-planning --grep @authorization --project=chromium",
    "test:e2e:resource-planning:numbering": "playwright test e2e/resource-planning --grep @numbering --project=chromium",
    "test:e2e:resource-planning:all": "playwright test e2e/resource-planning --project=chromium",
    "test:e2e:machine-and-resource-planning": "ALLOW_E2E_MUTATION=true npm run test:e2e:machine && ALLOW_E2E_MUTATION=true npm run test:e2e:resource-planning:all",
    "test:e2e:machine:report": "playwright show-report artifacts/playwright/report",
    "test:e2e:all": "npm run test:e2e:machine:all && npm run test:e2e:resource-planning:all",
    "test:e2e:regression": "npm run test:e2e:all",
    "test:e2e:report": "playwright show-report artifacts/playwright/report",
    "machines:reset": "node scripts/reset-won-seal-tech-machines.mjs --reset",
    "machines:verify": "node scripts/reset-won-seal-tech-machines.mjs --verify",
    "reset:seed:mes:wo": "MES_ENV=development CONFIRM_MASTER_DATA_RESET=YES_RESET_E2E_MASTER_DATA node scripts/seed-mes-wo-complete-dataset.mjs --seed"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "eslint": "^9.5.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
